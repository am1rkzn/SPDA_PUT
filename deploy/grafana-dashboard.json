{
  "uid": "put-backend",
  "title": "ПУТЬ · Backend",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "metrics",
        "type": "datasource",
        "query": "prometheus",
        "label": "Mimir"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP-запросы",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(put_http_requests_total{job=\"put-backend\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Доля ответов 5xx",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(put_http_requests_total{job=\"put-backend\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(put_http_requests_total{job=\"put-backend\"}[$__rate_interval])), 1e-9)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 · мс",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le)(rate(put_http_duration_milliseconds_bucket{job=\"put-backend\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Подборы и аренды",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event)(increase(put_events_total{job=\"put-backend\"}[$__rate_interval]))"
        }
      ]
    }
  ]
}
