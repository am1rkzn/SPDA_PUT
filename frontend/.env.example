# Скопируй этот файл в `.env` и отредактируй при необходимости.

# Режим данных:
#   true  — демо-данные в браузере (Backend не нужен, приложение работает сразу);
#   false — реальный Backend (FastAPI).
VITE_USE_MOCK=true

# Адрес Backend API (используется, когда VITE_USE_MOCK=false).
# При разработке через прокси достаточно относительного пути /api.
VITE_API_BASE_URL=/api

# Ключ Яндекс.Карт (JS API 2.1). Получить: https://developer.tech.yandex.ru/
# ВАЖНО: файл .env в .gitignore — ключ не попадёт в репозиторий.
# Для GitHub Pages не забудь добавить домен в «Ограничение по HTTP Referer».
VITE_YANDEX_API_KEY=
